# --- Directus server ---
HOST=0.0.0.0
PORT=8055
PUBLIC_URL=http://localhost:8055
KEY=replace-with-random-uuid
SECRET=replace-with-random-secret
TELEMETRY=false
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=directus_cms
DB_USER=postgres
DB_PASSWORD=your-db-password

# --- First admin (created on bootstrap) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password
